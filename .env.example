# Copie para .env e defina valores próprios. Nunca publique .env.
DB_PASSWORD=changeit
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
CPF_PEPPER=REPLACE_WITH_A_RANDOM_PEPPER
CPF_AES_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
# No ambiente local, as mensagens vão apenas para Mailpit (http://localhost:8025).
